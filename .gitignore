# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/reports/

# next.js
/.next/
/out/

# production
/build

# misc
.cache/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI tooling artifacts (project MCP is tracked)
.cursor/*
!.cursor/mcp.json
.agents/
skills-lock.json

# keep sharable Claude setup in repo, ignore only local overrides
CLAUDE.local.md
.claude/settings.local.json
# transient snapshots from `.claude/hooks/PreCompact.sh`
.claude/state/
.gstack/
