{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/run-next-dev.mjs",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "biome:check": "node ./scripts/run-biome.mjs check .",
    "biome:format": "node ./scripts/run-biome.mjs format --write .",
    "sandbox:report:sync": "node ./scripts/sync-sandbox-test-report.mjs",
    "lint": "node ./scripts/run-biome.mjs check .",
    "format": "node ./scripts/run-biome.mjs format --write .",
    "test": "playwright test",
    "test:all-except-planted": "playwright test --grep-invert @sandbox-planted",
    "test:store": "playwright test tests/e2e/sandbox --project=sandbox-store --project=sandbox-store-iphone-15-pro",
    "test:e2e": "playwright test tests/e2e --project=chromium --project=iphone-15-pro --project=sandbox-store --project=sandbox-store-iphone-15-pro",
    "test:e2e:sandbox": "pnpm run test:store",
    "test:e2e:mobile": "playwright test --project=iphone-15-pro --project=sandbox-store-iphone-15-pro",
    "test:e2e:ci": "playwright test --project=chromium --project=sandbox-store",
    "test:e2e:ci:all": "playwright test --project=chromium --project=sandbox-store --project=iphone-15-pro --project=sandbox-store-iphone-15-pro",
    "test:store:full": "pnpm run test:store && playwright test tests/api/routes.api.spec.ts --project=api",
    "test:api": "playwright test tests/api --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "learn:generate-topics": "node ./scripts/generate-playwright-learn-topics.mjs",
    "learn:check-uk-urls": "node ./scripts/check-uk-learn-playwright-urls.mjs",
    "learn:strip-non-ts-codeblocks": "node ./scripts/strip-playwright-learn-non-ts-codeblocks.mjs",
    "learn:strip-remote-media": "node ./scripts/strip-playwright-learn-remote-media.mjs"
  },
  "dependencies": {
    "convex": "^1.37.0",
    "mermaid": "^11.15.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
